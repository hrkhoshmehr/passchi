{
  "name": "kharkhoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "دستیار دانشجو — ربات تلگرام تحلیل صوت کلاس",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-sqlite --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@soniox/node": "^2.3.0",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "grammy": "^1.45.1",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.8.0",
    "teleproto": "^1.228.5",
    "tus-js-client": "^4.3.1",
    "vazirmatn": "^33.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ffprobe-static": "^2.0.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
