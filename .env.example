# ─── Telegram ──────────────────────────────────────────────────────────────
BOT_TOKEN=123456:ABC...
# اگر Local Bot API Server داری (برای فایل‌های بزرگ‌تر از ۲۰ مگابایت):
# TELEGRAM_API_ROOT=http://localhost:8081
# در حالت local server، فایل‌ها روی دیسک همان ماشین ساخته می‌شوند:
# TELEGRAM_LOCAL_MODE=false

# مسیر MTProto: سقف ۲۰ مگابایتی Bot API را برمی‌دارد بدون نیاز به سرور محلی.
# ورود با همان توکن ربات انجام می‌شود — حساب کاربری لازم نیست.
# از https://my.telegram.org/apps بگیر.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ─── Soniox (تبدیل گفتار به متن) ───────────────────────────────────────────
SONIOX_API_KEY=
SONIOX_MODEL=stt-async-v5

# ─── Anthropic (تحلیل) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# مدل تحلیل ساختاریافته (پاس ۱)
ANALYSIS_MODEL=claude-opus-5
# مدل تولید جزوه (پاس ۲) — می‌توانی برای کاهش هزینه claude-sonnet-5 بگذاری
NOTES_MODEL=claude-opus-5
ANALYSIS_EFFORT=high

# ─── مسیر رایگان (OpenRouter) ──────────────────────────────────────────────
# برای اجرای واقعی خط لوله بدون هزینه. هر پاس جداگانه قابل مسیریابی است.
OPENROUTER_API_KEY=
# anthropic | openrouter
ANALYSIS_PROVIDER=openrouter
NOTES_PROVIDER=openrouter
# مدل‌های OpenRouter برای هر پاس (خالی = OPENROUTER_MODEL)
# فهرست جداشده با کاما؛ اولی که جواب بدهد استفاده می‌شود
OPENROUTER_MODEL=google/gemini-3.7-flash,google/gemini-2.5-flash,qwen/qwen3-235b-a22b-2507
OPENROUTER_ANALYSIS_MODEL=
OPENROUTER_NOTES_MODEL=

# ─── پیش‌پردازش صوت ────────────────────────────────────────────────────────
# نرخ نمونه‌برداری هدف (مدل‌های ASR داخلی روی ۱۶ کیلوهرتز کار می‌کنند)
AUDIO_SAMPLE_RATE=16000
# بیت‌ریت Opus مونو؛ ۳۲k برای گفتار عملاً شفاف است، ۲۴k هم قابل قبول
AUDIO_BITRATE=32k
# حذف سکوت: off | edges | full
# اندازه‌گیری روی کلاس واقعی: آستانهٔ ۳۵- دسی‌بل فقط ۰٫۵٪ سکوت پیدا می‌کند و
# حتی ۱۸- دسی‌بل ۳٫۴٪ — کلاس نویز زمینهٔ پیوسته دارد. پس «full» یک دقیقه
# پردازنده می‌خورد تا کسری از یک سنت صرفه کند. «edges» فقط دو سر فایل را
# می‌بیند، که تنها حالت واقعاً پرسود است (ضبط زودتر روشن یا دیرتر خاموش شده).
SILENCE_TRIM=off
SILENCE_THRESHOLD_DB=-35
SILENCE_MIN_DURATION=2.5
SILENCE_PAD_MS=250
# اگر صرفه‌جویی کمتر از این درصد بود، اصلاً برش نزن (ریسک بی‌مورد)
SILENCE_MIN_GAIN_PCT=8

# ─── محدودیت‌ها ────────────────────────────────────────────────────────────
# کش رونویسی روی هش محتوای فایل. اگر دو نفر عین یک صوت را بفرستند فقط یک بار
# هزینه می‌دهیم؛ و تست‌کردن با یک فایل نمونه بعد از بار اول رایگان است.
STT_CACHE=true

MAX_AUDIO_MINUTES=240
# هدیهٔ شروع هر کاربر، به سکه.
#
# ⚠️ اینجا ۱۰۰ بود در حالی که پیش‌فرضِ کد ۲۰ است — و چون `.env` در `.gitignore`
# است و روی سرور دستی ساخته می‌شود، هر استقرارِ تازه پنج برابرِ هدیهٔ درست
# می‌داد. عدد از ۱۰۰ به ۲۰ آمد چون یک کلاسِ کامل رایگان گران بود و مسیر
# اشتراک‌گذاری را هم بی‌معنا می‌کرد؛ ۲۰ سکه اندازهٔ یک بار «برداشتنِ» جلسهٔ
# اشتراکیِ هم‌کلاسی است، که همان مسیر ورودیِ موردنظر است.
FREE_TRIAL_COINS=20
# چند کار همزمان پردازش شود
MAX_CONCURRENT_JOBS=2
DATA_DIR=./data
# حذف خودکار فایل صوتی اصلی بعد از این تعداد روز (۰ = بلافاصله بعد از تحلیل)
KEEP_AUDIO_DAYS=7

# ─── PDF ───────────────────────────────────────────────────────────────────
# اگر کروم سیستمی داری (روی ویندوز معمولاً این مسیر):
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ─── شارژ (کارت‌به‌کارت) ────────────────────────────────────────────────────
# اگر CARD_NUMBER خالی باشد، دکمهٔ شارژ کاربر را به پشتیبانی ارجاع می‌دهد.
CARD_NUMBER=
CARD_HOLDER=
# آیدی تلگرام پشتیبانی، بدون @
SUPPORT_USERNAME=

# ─── بایگانی ادمین ─────────────────────────────────────────────────────────
# شناسهٔ عددی کانال خصوصی‌ای که یک نسخه از هر جلسه در آن بایگانی می‌شود:
# صوت با کپشن (رایگان یا پولی، فرستنده، مدت، هزینه) و برای جلسهٔ پولی،
# گزارش کامل به‌صورت ریپلای همان صوت.
#
# ربات باید عضو کانال باشد و اجازهٔ ارسال داشته باشد. خالی بگذاری، این مسیر
# کاملاً خاموش است.
#
# ⚠️ شناسه باید **با پیشوند -100** باشد: -1004378784678 نه -4378784678.
# بعضی کلاینت‌های تلگرام شکل کوتاه را نشان می‌دهند ولی Bot API فقط شکل بلند
# را می‌شناسد و برای کوتاه «chat not found» می‌دهد. اگر مطمئن نیستی:
#   npx tsx -e 'import {Bot} from "grammy";import {config} from "./src/config.ts";
#   console.log(await new Bot(config.BOT_TOKEN).api.getChat(-100XXXXXXXXXX))'
#
# ⚠️ محتوایش خصوصی است (صوت کلاس و صدای دانشجوهای دیگر) — کانال را خصوصی
# نگه دار. متن /privacy هم به کاربر می‌گوید یک نسخه برای بازبینی می‌ماند.
ARCHIVE_CHAT_ID=

# ─── متفرقه ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# آی‌دی عددی ادمین‌ها، با کاما. رسیدهای شارژ برای همین‌ها فرستاده می‌شود
# و فقط همین‌ها می‌توانند تأیید/رد کنند.
ADMIN_IDS=

# ─── بله ───────────────────────────────────────────────────────────────────
# ربات بله: همان دست‌کدهای تلگرام روی سرور بله اجرا می‌شوند.
# خالی بگذاری، کل مسیر بله خاموش است.
# توکن را از @BotFather داخل خود بله بگیر.
BALE_BOT_TOKEN=
BALE_API_ROOT=https://tapi.bale.ai

# ─── سرور وب و مینی‌اپ ─────────────────────────────────────────────────────
WEB_ENABLED=true
WEB_PORT=3000
# آدرس عمومی سایت. تلگرام و بله هر دو برای مینی‌اپ HTTPS *اجبار* می‌کنند؛
# با http://localhost دکمهٔ مینی‌اپ اصلاً ساخته نمی‌شود. برای توسعهٔ محلی
# یک تونل لازم است (cloudflared یا ngrok).
PUBLIC_URL=

# ─── پیامک (ورود با شماره از مرورگر) ───────────────────────────────────────
# ⚠️ تا وقتی SMS_ENDPOINT خالی باشد، کد تأیید در *پاسخ HTTP* برگردانده می‌شود
# تا توسعه ممکن باشد. در تولید حتماً پرش کن، وگرنه هرکسی با دانستن یک شماره
# وارد حساب صاحبش می‌شود. وضعیتش در لاگ راه‌اندازی چاپ می‌شود.
SMS_PROVIDER=
# آدرس درگاه با جاگذاری {phone} و {code} — عوض‌کردن ارائه‌دهنده فقط همین خط است.
# نمونه (کاوه‌نگار):
# SMS_ENDPOINT=https://api.kavenegar.com/v1/APIKEY/verify/lookup.json?receptor={phone}&token={code}&template=TEMPLATE
SMS_ENDPOINT=
SMS_METHOD=GET
